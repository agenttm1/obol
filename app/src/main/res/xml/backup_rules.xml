<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8: ne razlikuje oblak od prijenosa na novi uređaj, pa se zbog obećanja
  o privatnosti (spec, poglavlje 9) ne kopira ništa. Novije verzije: xml-v28/.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
